{
  "name": "heatcircuits",
  "version": "0.1.0",
  "private": true,
  "description": "Planungssoftware für Flächenheizungen nach EN 12831 und EN 1264 – metrisch, °C, für Europa.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build:single && node scripts/build-artifact.mjs",
    "cad:dev": "vite --config cad/vite.config.ts",
    "cad:build": "tsc --noEmit && vite build --config cad/vite.config.ts",
    "cad:build:single": "vite build --config cad/vite.config.ts --mode single",
    "cad:build:artifact": "npm run cad:build:single && node scripts/build-artifact.mjs dist-cad-single hauscad.html"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
