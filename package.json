{
  "name": "heatcircuits",
  "version": "0.1.0",
  "private": true,
  "description": "Planungssoftware für Flächenheizungen nach EN 12831 und EN 1264 – metrisch, °C, für Europa.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build:single && node scripts/build-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "web-ifc": "0.0.78"
  }
}
